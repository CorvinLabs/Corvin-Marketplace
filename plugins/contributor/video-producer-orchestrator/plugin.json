{
  "id": "video-producer-orchestrator",
  "name": "Video Producer",
  "version": "1.0.0",
  "description": "Generate professional demo videos from storyboards with quality gates and learning integration",
  "author": "CorvinOS Contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/CorvinLabs/Corvin-Marketplace/tree/main/plugins/contributor/video-producer-orchestrator",
  "repository": "github:CorvinLabs/Corvin-Marketplace",
  "entry_point": "src.plugin:VideoProducerPlugin",
  "boot_layer": "bundled",
  "dependencies": [
    "pillow>=9.0.0",
    "google-cloud-texttospeech>=2.14.0",
    "pydub>=0.25.0",
    "ffmpeg-python>=0.2.1",
    "numpy>=1.21.0",
    "scipy>=1.7.0"
  ],
  "capabilities": [
    "video:generate",
    "video:validate",
    "video:promote",
    "video:publish"
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "google_tts_enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable Google Cloud TTS (requires credentials)"
      },
      "piper_fallback_enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable Piper TTS fallback (offline, always available)"
      },
      "quality_gate_draft_max": {
        "type": "integer",
        "default": 50,
        "description": "Quality score threshold for DRAFT gate"
      },
      "quality_gate_production_min": {
        "type": "integer",
        "default": 50,
        "description": "Quality score threshold for PRODUCTION gate"
      },
      "quality_gate_broadcast_min": {
        "type": "integer",
        "default": 85,
        "description": "Quality score threshold for BROADCAST gate (never lower)"
      },
      "design_system_path": {
        "type": "string",
        "default": "design_system.json",
        "description": "Path to design system JSON file"
      },
      "cache_duration_days": {
        "type": "integer",
        "default": 30,
        "description": "Cache TTS audio for N days"
      }
    },
    "required": ["design_system_path"]
  },
  "audit_events": [
    "plugin_bootstrap",
    "plugin_shutdown",
    "video_generation_started",
    "storyboard_extracted",
    "slide_generated",
    "audio_generated",
    "video_assembled",
    "quality_validated",
    "quality_gate_decision",
    "video_promoted",
    "video_published",
    "learning_event_emitted"
  ],
  "console_routes": [
    {
      "path": "/console/video-producer",
      "method": "GET",
      "description": "Video Producer dashboard"
    },
    {
      "path": "/api/video-producer/generate",
      "method": "POST",
      "description": "Generate new video"
    },
    {
      "path": "/api/video-producer/{job_id}",
      "method": "GET",
      "description": "Get video job status"
    },
    {
      "path": "/api/video-producer/{job_id}/promote",
      "method": "POST",
      "description": "Promote DRAFT to PRODUCTION"
    }
  ]
}
