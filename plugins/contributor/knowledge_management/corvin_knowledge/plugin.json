    "installation": "https://github.com/CorvinLabs/Corvin-Marketplace/blob/main/plugins/knowledge-management/corvin-knowledge/docs/INSTALLATION.md",
    "console_integration": "https://github.com/CorvinLabs/Corvin-Marketplace/blob/main/plugins/knowledge-management/corvin-knowledge/docs/CONSOLE_INTEGRATION.md",
    "user_guide": "https://github.com/CorvinLabs/Corvin-Marketplace/blob/main/plugins/knowledge-management/corvin-knowledge/README.md#quick-start"
  },

  "support": {
