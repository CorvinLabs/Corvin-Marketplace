{
  "id": "corvin-knowledge",
  "name": "Corvin-Knowledge: Agentic Knowledge Mesh",
  "version": "1.0.0",
  "description": "Query, sync, and propose knowledge across distributed teams. Git-backed, fail-closed validation.",

  "author": {
    "name": "Shumway + Claude Haiku 4.5",
    "url": "https://github.com/CorvinLabs"
  },

  "license": "Apache-2.0",
  "category": "knowledge-management",
  "type": "agentic-tool",

  "tags": [
    "knowledge-management",
    "distributed-teams",
    "git-based",
    "agentic-ai",
    "decision-records",
    "concepts",
    "ideas",
    "collaboration"
  ],

  "description_long": "Corvin-Knowledge is a distributed knowledge management plugin for Claude Code that enables agents and teams to:\n\n- Query architectural decisions (ADRs), concepts, and ideas across projects\n- Sync knowledge bases across distributed teams with Git-based conflict resolution\n- Propose new entities via GitHub PRs (no manual Git needed)\n- Configure independent knowledge repositories per team\n- Validate consistency automatically (circular deps, PII, duplicates)\n\nFeatured use cases:\n- Querying shared architectural decisions during code review\n- Multi-team knowledge synchronization without data loss\n- Proposing new patterns/ideas for team review\n- Building agent-queryable knowledge graphs\n\nArchitecture: Three-layer design (Manifest + Entry Point + SDK), fail-closed validation, Git-based sync.",

  "capabilities": [
    "query_entities",
    "get_graph",
    "sync_repository",
    "propose_entity",
    "validate_consistency"
  ],

  "commands": [
    {
      "name": "query",
      "description": "Search knowledge by tag, project, or status",
      "example": "mesh query --tag=skills --project=CorvinOS"
    },
    {
      "name": "sync",
      "description": "Sync with remote repository (pull, push, validate)",
      "example": "mesh sync --pull --consistency=strict"
    },
    {
      "name": "propose",
      "description": "Propose new entity (idea, concept, implementation)",
      "example": "mesh propose --type=idea --title='...' --body='...'"
    },
    {
      "name": "config",
      "description": "Configure plugin (repo path, remote URL, sync settings)",
      "example": "mesh config --repo-path ~/.my-knowledge"
    }
  ],

  "dependencies": {
    "python": ">=3.9",
    "git": ">=2.25",
    "claude_code": ">=1.0.0"
  },

  "configuration": {
    "repo_path": {
      "type": "string",
      "description": "Local path to knowledge repository",
      "default": "~/.corvin-knowledge/",
      "required": true
    },
    "remote_url": {
      "type": "string",
      "description": "Git remote URL (GitHub, GitLab, etc.)",
      "default": "https://github.com/CorvinLabs/Corvin-Knowledge.git"
    },
    "auto_sync_on_query": {
      "type": "boolean",
      "description": "Automatically pull latest before queries",
      "default": true
    },
    "consistency_level": {
      "type": "string",
      "enum": ["strict", "warn", "ignore"],
      "description": "How to handle consistency errors",
      "default": "warn"
    }
  },

  "installation": {
    "method": "marketplace",
    "source_url": "https://github.com/CorvinLabs/Corvin-Marketplace/tree/main/plugins/knowledge-management/corvin-knowledge",
    "marketplace_package": "https://github.com/CorvinLabs/Corvin-Marketplace/releases/download/v1.0.0/corvin-knowledge-1.0.0.zip",
    "checksum_sha256": "auto_computed_at_release"
  },

  "documentation": {
