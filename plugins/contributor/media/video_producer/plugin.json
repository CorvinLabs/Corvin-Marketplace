{
  "id": "plugin:contributor-media-video_producer",
  "type": "plugin",
  "name": "Video Producer",
  "version": "1.0.0",
  "author": "CorvinOS Contributors",
  "license": "Apache-2.0",
  "license_url": "https://github.com/CorvinLabs/Corvin-Marketplace/blob/main/LICENSE",
  "tier": "contributor",
  "category": "media",
  "description": "Create CorvinOS marketing and explainer videos from PowerPoints, screenshots, and voice narration. Orchestrated multi-skill system with deep asset analysis, per-scene feedback, and learning loops.",
  "readme_url": "https://github.com/CorvinLabs/Corvin-Marketplace/blob/main/plugins/contributor/media/video_producer/README.md",
  "documentation": "docs/README.md",
  "adr_prefix": "video-producer",
  "docs_location": "docs/",
  "development_guide": "docs/PLUGIN-DEVELOPMENT-GUIDE.md",
  "adr_graph": "docs/ADR-GRAPH.md",
  "distribution": {
    "supports_source": true,
    "supports_wheel": false,
    "source_url": "https://github.com/CorvinLabs/Corvin-Marketplace/tree/main/plugins/contributor/media/video_producer"
  },
  "dependencies": [],
  "requires_version": ">=1.0.0",
  "boot_layer": "installed",
  "sla_level": "contributor",
  "maintainer_url": "mailto:corvinOS-team@anthropic.com",
  "tags": [
    "media",
    "integration",
    "ai-learning"
  ],
  "capabilities": [
    "video-production",
    "asset-analysis",
    "voice-narration",
    "screenshot-capture",
    "slide-rendering",
    "video-assembly",
    "youtube-export"
  ],
  "entry_points": {
    "renderers": [
      {
        "id": "svg_renderer",
        "name": "SVG Renderer",
        "module": "video_producer.renderers_skill_2_0.svg_renderer:SvgRenderer",
        "description": "Renders flowcharts and diagrams to SVG"
      },
      {
        "id": "effects_processor",
        "name": "Effects Processor",
        "module": "video_producer.renderers_skill_2_0.effects_processor:EffectsProcessor",
        "description": "Processes video effects and transitions"
      },
      {
        "id": "screencast_renderer",
        "name": "Screencast Renderer",
        "module": "video_producer.renderers_skill_2_0.screencast_renderer:ScreencastRenderer",
        "description": "Captures and composes screencast videos"
      },
      {
        "id": "blender_renderer",
        "name": "Blender Renderer",
        "module": "video_producer.renderers_skill_2_0.blender_renderer:BlenderRenderer",
        "description": "Renders 3D scenes using Blender"
      }
    ],
    "console_panels": [
      {
        "id": "video-producer-panel",
        "title": "Video Producer",
        "icon": "film",
        "route": "/video-producer",
        "component": "VideoProducerPanel",
        "category": "media"
      }
    ],
    "skills": [
      {
        "id": "os.video_producer",
        "name": "Video Producer Orchestrator",
        "description": "Main orchestrator for video production workflow using multi-skill architecture"
      }
    ]
  },
  "config": {
    "tts_engine": "openai",
    "tts_model": "tts-1-hd",
    "tts_voice": "nova",
    "youtube_upload_supported": true,
    "max_video_length_minutes": 60,
    "enable_learning_loops": true,
    "audit_enabled": true
  },
  "permissions": [
    "console:read",
    "console:write",
    "skills:execute",
    "tasks:manage",
    "learning:write",
    "audit:read"
  ]
}
