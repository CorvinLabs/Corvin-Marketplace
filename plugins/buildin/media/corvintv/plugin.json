{
  "id": "plugin:buildin-media-corvintv",
  "type": "plugin",
  "name": "CorvinTV",
  "version": "1.7.1",
  "author": "CorvinOS Contributors",
  "license": "Apache-2.0",
  "license_url": "https://github.com/CorvinLabs/Corvin-Marketplace/blob/main/LICENSE",
  "tier": "buildin",
  "category": "media",
  "description": "CorvinTV (formerly Video Producer): turn a task description into a professional narrated video - LLM storyboard, narration by OpenAI TTS with edge-tts as the fallback, animated web slides (corvin-labs.com design, 19 templates, incl. board: an imported Penpot design revealed step by step, and bento) whose reveals and focus follow the spoken words, then MP4. Deterministic headless-Chromium rendering with a Pillow fallback. See docs/WEB-SLIDES.md, USER-GUIDE.md.",
  "readme_url": "https://github.com/CorvinLabs/Corvin-Marketplace/blob/main/plugins/buildin/media/corvintv/README.md",
  "documentation": "docs/README.md",
  "adr_prefix": "video-producer",
  "docs_location": "docs/",
  "development_guide": "docs/PLUGIN-DEVELOPMENT-GUIDE.md",
  "adr_graph": "docs/ADR-GRAPH.md",
  "distribution": {
    "supports_source": true,
    "supports_wheel": false,
    "source_url": "https://github.com/CorvinLabs/Corvin-Marketplace/tree/main/plugins/buildin/media/corvintv"
  },
  "security_audit": {
    "audited": false
  },
  "dependencies": [],
  "requires_version": ">=1.0.0",
  "boot_layer": "installed",
  "sla_level": "buildin",
  "maintainer_url": "mailto:corvinOS-team@anthropic.com",
  "tags": [
    "media",
    "integration",
    "ai-learning"
  ],
  "capabilities": [
    "video-assembly",
    "video-production",
    "voice-narration",
    "web-slides"
  ],
  "entry_points": {
    "console_panels": [
      {
        "id": "video-producer-panel",
        "title": "CorvinTV",
        "icon": "film",
        "route": "/video-producer",
        "component": "VideoProducerPanel",
        "category": "media"
      }
    ],
    "skills": [
      {
        "id": "os.video_producer",
        "name": "CorvinTV",
        "description": "Turns a task description into a short narrated MP4 (storyboard, TTS, ffmpeg assembly)."
      }
    ]
  },
  "config": {
    "tts_engine": "auto",
    "youtube_upload_supported": false,
    "max_video_length_minutes": 60,
    "audit_enabled": true,
    "web_slides": true,
    "web_theme": "dark",
    "web_fps": 30
  },
  "permissions": [
    "console:read",
    "console:write",
    "skills:execute",
    "tasks:manage",
    "learning:write",
    "audit:read"
  ]
}
